# Template for the PostgreSQL credentials used by validation.PostgresUserIDStore.
# Copy this file to .env and fill in real values. Safe to commit (no secrets).
DB_HOST=
DB_PORT=4444
DB_USER=
DB_PASSWORD=
DB_NAME=

# SilkWay OCR endpoint, used by client.py to call the deployed service.
# OCR_ENDPOINT_URL defaults to the deployed app if unset; API_TOKEN must match
# the token in the silkway-secrets Modal secret (leave empty if the endpoint
# runs open). These are the client's config — the server reads its own copy from
# the Modal secret, not from here.
OCR_ENDPOINT_URL=
API_TOKEN=
